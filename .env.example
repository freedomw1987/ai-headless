# ==============================================
# Database (PostgreSQL)
# ==============================================
DATABASE_URL="postgresql://user:password@localhost:5432/ai_headless?schema=public"

# ==============================================
# Next Auth
# ==============================================
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ==============================================
# AI Providers
# ==============================================
# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Default provider: openai | anthropic
AI_DEFAULT_PROVIDER="openai"

# ==============================================
# MockProvider 延迟 (TD-504)
# ==============================================
# 預設 0（快速，適合 CI/test）。Demo UI 設 15 保留打字效果。
# MOCK_STREAM_DELAY_MS="15"
# MOCK_GENERATE_DELAY_MS="100"

# ==============================================
# pi agent Configuration (MVP 階段)
# ==============================================
PI_AGENT_ENABLED="true"
PI_AGENT_TIMEOUT_MS="60000"

# ==============================================
# Application
# ==============================================
NODE_ENV="development"
LOG_LEVEL="info"
