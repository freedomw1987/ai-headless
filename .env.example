# ==============================================
# Database (PostgreSQL)
# ==============================================
DATABASE_URL="postgresql://user:password@localhost:5432/ai_headless?schema=public"

# ==============================================
# Next Auth
# ==============================================
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ==============================================
# AI Providers
# ==============================================
# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Sprint 43 v2.0: AES-256-GCM encryption key for AIConfig apiKeyEnc
# REQUIRED for production. Generate new with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex chars (32 bytes).
#
# ⚠️ WARNING / 警告:
# - AI_ENCRYPTION_KEY is REQUIRED for AIConfig AES-256-GCM encryption
# - Production deploy 必須設定, 否則所有 AI API Key 解密會 throw
# - Don't commit the actual key to git (.env is in .gitignore)
# - 開發環境可使用 node -e 指令生成, 但 production 必須為獨立 secret (例如 Vercel env)
# - 失去 key = 所有加密的 AI API Key 永久無法解密, 需重輸入
AI_ENCRYPTION_KEY=""

# Default provider: openai | anthropic
AI_DEFAULT_PROVIDER="openai"

# ==============================================
# MockProvider 延迟 (TD-504)
# ==============================================
# 預設 0（快速，適合 CI/test）。Demo UI 設 15 保留打字效果。
# MOCK_STREAM_DELAY_MS="15"
# MOCK_GENERATE_DELAY_MS="100"

# ==============================================
# pi agent Configuration (MVP 階段)
# ==============================================
PI_AGENT_ENABLED="true"
PI_AGENT_TIMEOUT_MS="60000"

# ==============================================
# Application
# ==============================================
NODE_ENV="development"
LOG_LEVEL="info"

# ==============================================
# Cleanup Cron (Sprint 47-5, FR-6.5)
# ==============================================
# Vercel Cron 與 pnpm cleanup:once 共用的 bearer token
# 開發環境可任意設定 (e.g. "dev-secret")
# Production 必須為獨立高熵 secret (e.g. openssl rand -hex 32)
CRON_SECRET="dev-secret-replace-in-prod"

# ==============================================
# Email Service (Sprint 56 R2 + P0-1 + P0-2)
# ==============================================
# 開發環境：留空 → 自動用 ethereal.email (fake SMTP，會 log 預覽 URL)
# Production：填入你的 SMTP 服務 (Resend / SendGrid / AWS SES 等)
#
# Resend 設定範例：
#   SMTP_HOST="smtp.resend.com"
#   SMTP_PORT="587"
#   SMTP_USER="resend"
#   SMTP_PASS="re_xxxxxxxxxxxx"
#   SMTP_FROM="noreply@yourdomain.com"
#   SMTP_SECURE="false"
#
# 必填環境變數 (未設全部時 = 未設定，使用 ethereal)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@ai-headless.local"
SMTP_SECURE="false"

# ==============================================
# Sentry (Sprint 57 P0-3)
# ==============================================
# 開發環境：留空 → silent no-op，不 throw
# Production：填入你的 Sentry project 設定
#
# 在 https://sentry.io 註冊 → New Project → Next.js → 拿 DSN
# SENTRY_AUTH_TOKEN 用於 CI 上傳 source map (Settings → Auth Tokens)
#
# 範例：
#   SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
#   SENTRY_ORG="your-org-slug"
#   SENTRY_PROJECT="ai-headless"
#   SENTRY_AUTH_TOKEN="sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT="ai-headless"
SENTRY_AUTH_TOKEN=""
