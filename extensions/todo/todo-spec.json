{
  "name": "todo",
  "label": "待辦事項",
  "requiresExtension": "todo",
  "list": {
    "allowColumnToggle": true,
    "defaultColumns": ["title", "completed", "dueDate", "priority"],
    "views": [
      { "type": "table", "label": "表格" },
      { "type": "todo-list", "label": "待辦清單", "primaryField": "title" },
      { "type": "kanban", "label": "看板", "primaryField": "title", "groupByField": "priority" },
      { "type": "calendar", "label": "月曆", "primaryField": "title", "dateField": "dueDate" }
    ]
  },
  "models": [
    {
      "name": "Todo",
      "label": "待辦",
      "description": "個人待辦事項",
      "fields": [
        {
          "name": "title",
          "type": "string",
          "label": "標題",
          "validation": { "required": true, "min": 1, "max": 200 },
          "list": { "defaultVisible": true }
        },
        {
          "name": "description",
          "type": "text",
          "label": "描述"
        },
        {
          "name": "completed",
          "type": "boolean",
          "label": "已完成",
          "validation": { "default": false },
          "list": { "defaultVisible": true }
        },
        {
          "name": "dueDate",
          "type": "datetime",
          "label": "截止日期",
          "list": { "defaultVisible": true }
        },
        {
          "name": "priority",
          "type": "enum",
          "label": "優先級",
          "validation": {
            "enum": ["low", "medium", "high"],
            "default": "medium"
          },
          "list": { "defaultVisible": true }
        }
      ],
      "computed": [
        {
          "name": "remainingDays",
          "type": "number",
          "label": "剩餘天數",
          "compute": "{{fn:remainingDays}}"
        }
      ],
      "hooks": {
        "beforeCreate": "{{fn:beforeCreateTodo}}"
      },
      "actions": [
        {
          "name": "complete",
          "label": "標記完成",
          "input": [],
          "implementation": "{{fn:completeTodo}}"
        }
      ],
      "softDelete": true
    }
  ]
}